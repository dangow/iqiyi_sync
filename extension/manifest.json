{
  "manifest_version": 3,
  "name": "同步觀影",
  "version": "2.0",
  "description": "和朋友同步 YouTube / Netflix / 愛奇藝的播放、暫停、跳轉",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://*.iqiyi.com/*", "https://*.iq.com/*", "https://*.youtube.com/*", "https://*.netflix.com/*"],
      "js": ["bridge.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.iqiyi.com/*", "https://*.iq.com/*", "https://*.youtube.com/*", "https://*.netflix.com/*"],
      "js": ["main.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
